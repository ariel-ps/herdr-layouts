#!/usr/bin/env python3
"""Claude Code session lookups for layout save and load.

A layout restores shells; it cannot restore the conversations that were in them.
Both halves of that gap are here:

  newest <cwd>          the session a pane is most likely sitting in
  prompt <cwd> <id>     that session's opening user turn, for the sidecar
  match  <cwd> <text>   newest session whose opening turn contains <text>

Save pins the id and records the prompt; load prefers the id and falls back to
the prompt, because an id can be deleted or archived while the conversation that
gave a pane its role is still findable by how it started.

Prints one value, or nothing.
"""

import glob
import json
import os
import sys

PROJECTS = os.path.expanduser("~/.claude/projects")


def project_dir(cwd):
    # Claude encodes a project directory by replacing every / and . with -.
    return os.path.join(
        PROJECTS, os.path.abspath(os.path.expanduser(cwd)).replace("/", "-").replace(".", "-")
    )


def sessions(cwd):
    return sorted(
        glob.glob(os.path.join(project_dir(cwd), "*.jsonl")),
        key=os.path.getmtime,
        reverse=True,
    )


def first_user_text(path):
    with open(path, encoding="utf-8", errors="replace") as fh:
        for line in fh:
            try:
                obj = json.loads(line)
            except ValueError:
                continue
            if obj.get("type") != "user":
                continue
            content = obj.get("message", {}).get("content", "")
            if isinstance(content, list):
                content = " ".join(
                    part.get("text", "") for part in content if isinstance(part, dict)
                )
            return " ".join(content.split())
    return ""


def main(argv):
    if len(argv) < 3:
        print(__doc__.strip(), file=sys.stderr)
        return 2
    mode, cwd = argv[1], argv[2]

    if mode == "newest":
        found = sessions(cwd)
        if not found:
            return 1
        print(os.path.basename(found[0])[: -len(".jsonl")])
        return 0

    if mode == "prompt" and len(argv) == 4:
        path = os.path.join(project_dir(cwd), argv[3] + ".jsonl")
        if not os.path.exists(path):
            return 1
        # 80 characters is enough to name a role and short enough to survive an
        # edit further down the same opening message.
        print(first_user_text(path)[:80])
        return 0

    if mode == "match" and len(argv) == 4:
        for path in sessions(cwd):
            try:
                if argv[3] in first_user_text(path):
                    print(os.path.basename(path)[: -len(".jsonl")])
                    return 0
            except OSError:
                continue
        return 1

    print(__doc__.strip(), file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv))
